{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "{{#if (equals datasource 'github')}}github-tags{{else}}{{{datasource}}}{{/if}}",
      "managerFilePatterns": [
        "/^.*$/"
      ],
      "matchStrings": [
        "\\s*#\\s?renovate: (?<datasource>.*?)=(?<depName>.*?)(\\s+versioning=(?<versioning>.*?))?\\s+[\\w+\\.\\-]+(?:[:=]|\\s+\\S+)\\s*[\\\"']?(?<currentValue>[\\w+\\.\\-]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\\\"']?"
      ],
      "versioningTemplate": "{{#if (equals datasource 'docker')}}docker{{else if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "extends": [
    ":configMigration",
    ":dependencyDashboard",
    ":enablePreCommit",
    ":enableVulnerabilityAlerts",
    ":ignoreModulesAndTests",
    ":maintainLockFilesWeekly",
    ":prConcurrentLimitNone",
    ":rebaseStalePrs",
    ":semanticPrefixFixDepsChoreOthers",
    ":separateMultipleMajorReleases",
    "config:recommended",
    "group:monorepos",
    "group:recommended",
    "helpers:pinGitHubActionDigests",
    "replacements:all",
    "workarounds:all"
  ],
  "minimumReleaseAge": "14 days",
  "nix": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "automerge": false,
      "automergeStrategy": "rebase",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "lockFileMaintenance",
        "digest"
      ]
    },
    {
      "description": "Use build(deps) for all updates (overrides :semanticPrefixFixDepsChoreOthers)",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "build"
    },
    {
      "description": "Bump the go.mod go directive to each Go release (Renovate reads it as a minimum and skips it by default); Go releases skip the release-age wait so security point releases land promptly",
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchManagers": [
        "gomod"
      ],
      "minimumReleaseAge": "0 days",
      "rangeStrategy": "bump"
    },
    {
      "description": "Digest pins and lock-file refreshes carry security fixes (rebuilt images, patched transitive deps): when the hourly limit queues PRs, create these first",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance"
      ],
      "prPriority": 5
    },
    {
      "description": "Group all non-major updates into one PR (vulnerability alerts opt out via top-level vulnerabilityAlerts)",
      "groupName": "non-major dependencies",
      "groupSlug": "non-major-deps",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ]
    },
    {
      "description": "Pin image digests in Dockerfiles, compose files and workflow containers: a tag can be re-pushed, a digest cannot. Kubernetes, kustomize and Helm images stay with each repo's own rules",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Digest updates wait 3 days, not 14 (rebuilt images carry security fixes), and do not wait forever where the registry gives no timestamp (ghcr.io, gcr.io, quay.io)",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "pre-commit hooks move together, in one PR per repo. Renovate keeps a frozen rev (commit SHA with a '# frozen: <tag>' comment) frozen; it cannot freeze a tag itself",
      "groupName": "pre-commit hooks",
      "groupSlug": "pre-commit-hooks",
      "matchManagers": [
        "pre-commit"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "rebaseWhen": "conflicted",
  "schedule": [
    "before 6am on monday"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": null,
    "groupSlug": null,
    "schedule": [],
    "semanticCommitScope": "deps-security",
    "semanticCommitType": "fix"
  }
}
